# Firebase
FIREBASE_WEB_API_KEY=
FIREBASE_APP_ID=
# Solo para dev local sin Firebase configurado — NUNCA en producción.
# Si falta FIREBASE_WEB_API_KEY y esto no es "true", la auth falla cerrada (401).
ALLOW_DEV_AUTH=false

# Database
# - Docker Compose (misma red): host `postgres_container`
# - `go run` local: host `localhost`
DATABASE_URL=postgres://budget:change-me@postgres_container:5432/budget

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_USE_SSL=false

# AI
AI_API_KEY=
AI_API_ENDPOINT=https://opencode.ai/zen/go/v1

# CORS — orígenes permitidos separados por coma (ej. tu dominio público).
# Solo afecta clientes browser; la app móvil nativa no envía header Origin.
# Si se omite, el backend usa http://localhost:4000 (solo dev).
ALLOWED_ORIGINS=https://api.example.com
